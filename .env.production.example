# Plantilla del .env de PRODUCCIÓN (VPS). Mismas claves que .env.example.
# En el VPS, dentro de la carpeta del repo:
#   cp .env.production.example .env
#   sed -i "s/__GENERA_CON_OPENSSL__/$(openssl rand -hex 32)/" .env
#   nano .env   # pega las claves y sustituye TODOS los <IP_VPS>
# .env está en .gitignore: nunca se commitea. Sin valores reales aquí.
# Ojo: docker compose interpreta "$" en los valores; si un secreto lleva "$",
# escríbelo como "$$".

# ---------------------------------------------------------------------------
# API (services/api)
# ---------------------------------------------------------------------------
# Obligatoria. Se genera con: openssl rand -hex 32  (lo hace el sed de arriba)
SECRET_KEY=__GENERA_CON_OPENSSL__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Obligatoria: Supabase → Connect → Direct → "Transaction pooler", tipo URI.
# Si la contraseña tiene caracteres especiales (@ : / ? # %), codifícalos en la URL (@ → %40).
DATABASE_URL=<PEGA_AQUI_LA_URI_DEL_TRANSACTION_POOLER_DE_SUPABASE>

# Recuperación de contraseña (AUTH-03). Si no tienes clave, deja el valor VACÍO
# (RESEND_API_KEY=): la API arranca igual y no envía emails.
RESEND_API_KEY=<PEGA_AQUI_TU_CLAVE_DE_RESEND_O_DEJALO_VACIO>
EMAIL_FROM=Nexova <onboarding@resend.dev>
# URL del backoffice tal como la abre el navegador (va en el enlace del email)
FRONTEND_URL=http://<IP_VPS>:3001
RESET_TOKEN_EXPIRE_MINUTES=30

# Orígenes desde los que el navegador llama a la API (lista JSON)
CORS_ORIGINS=["http://<IP_VPS>:3000","http://<IP_VPS>:3001"]

# Opcional: carpeta de TinyDB. Por defecto services/api/data (montada desde el host)
# NEXOVA_DATA_DIR=

# ---------------------------------------------------------------------------
# Backoffice (uis/backoffice)
# ---------------------------------------------------------------------------
# La usa el NAVEGADOR, así que debe ser la IP pública del VPS, nunca http://api:8000
NEXT_PUBLIC_API_URL=http://<IP_VPS>:8000
