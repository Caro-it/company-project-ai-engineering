# Variables de docker-compose.yml (servicios "uis" y "api").
#   cp .env.example .env
# .env está en .gitignore: nunca se commitea. Sin valores reales aquí.
# Ojo: docker compose interpreta "$" en los valores; si un secreto lleva "$",
# escríbelo como "$$".

# ---------------------------------------------------------------------------
# API (services/api)
# ---------------------------------------------------------------------------
# Obligatoria. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Inventario (Hito 5), obligatoria: Supabase → Connect → Direct → "Transaction pooler", tipo URI.
# Si la contraseña tiene caracteres especiales (@ : / ? # %), codifícalos en la URL (@ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres

# Recuperación de contraseña (AUTH-03). Sin RESEND_API_KEY no se envía el email.
RESEND_API_KEY=
EMAIL_FROM=Nexova <onboarding@resend.dev>
# URL del backoffice tal como la abre el navegador (va en el enlace del email)
FRONTEND_URL=http://localhost:3001
RESET_TOKEN_EXPIRE_MINUTES=30

# Orígenes que el navegador usa para llamar a la API (lista JSON).
# website → 3000, backoffice → 3001. En el VPS: http://<IP_VPS>:3000 y :3001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Opcional: carpeta de TinyDB. Por defecto services/api/data (montada desde el host)
# NEXOVA_DATA_DIR=

# ---------------------------------------------------------------------------
# Backoffice (uis/backoffice)
# ---------------------------------------------------------------------------
# La usa el NAVEGADOR (todas las llamadas a la API salen de componentes de
# cliente), así que no puede ser http://api:8000: ese nombre solo existe en la
# red interna de Docker. En local, localhost; en el VPS, http://<IP_VPS>:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
