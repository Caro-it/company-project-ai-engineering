SECRET_KEY=cambia-esto
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Recuperación de contraseña (AUTH-03). Sin RESEND_API_KEY no se envía el email.
# Clave de https://resend.com/api-keys (nunca en el código ni en git)
RESEND_API_KEY=
# onboarding@resend.dev solo entrega al email de tu cuenta de Resend;
# para otros destinatarios hace falta un dominio verificado
EMAIL_FROM=Nexova <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3001
RESET_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos por CORS, como lista JSON (opcional).
# Por defecto: ["http://localhost:3000","http://localhost:3001"]
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Inventario (Hito 5): Supabase → Connect → Direct → "Transaction pooler", tipo URI.
# Pega la URI tal cual y sustituye [YOUR-PASSWORD]. Si la contraseña tiene
# caracteres especiales (@ : / ? # %), codifícalos en la URL (p. ej. @ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres
