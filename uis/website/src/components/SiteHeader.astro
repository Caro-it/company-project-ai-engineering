---
import { withBase } from '../lib/paths';

interface Props {
  currentPage: 'inicio' | 'talento';
}

const { currentPage } = Astro.props;
const onLanding = currentPage === 'inicio';
// En la landing las anclas son locales; desde otras páginas vuelven a index.html.
const anchor = (id: string) => (onLanding ? `#${id}` : withBase(`index.html#${id}`));

const links = [
  { label: 'Inicio', href: anchor('inicio'), current: false },
  { label: 'Servicios', href: anchor('servicios'), current: false },
  { label: 'Talento', href: withBase('application.html'), current: currentPage === 'talento' },
  { label: 'Contacto', href: anchor('contacto'), current: false },
];

const focus = 'focus:outline-hidden focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2';
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
  >
    <a href={anchor('inicio')} class={`text-2xl font-bold tracking-tight text-[#001D4A] ${focus}`}>
      Nexova
    </a>

    <nav aria-label="Navegación principal">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium sm:text-base">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
                class:list={[
                  'rounded-sm px-1 py-1 text-[#006992]',
                  link.current ? 'font-semibold underline' : 'hover:underline',
                  focus,
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
