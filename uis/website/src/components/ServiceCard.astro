---
import Card from './Card.astro';

interface Props {
  title: string;
  items: string[];
  class?: string;
}

const { title, items, class: extraClass } = Astro.props;
---

<Card class={extraClass}>
  <h3 class="text-lg font-semibold text-[#001D4A] sm:text-xl">{title}</h3>
  <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-700">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</Card>
