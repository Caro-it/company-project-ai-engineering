---
import FieldError from './FieldError.astro';

interface Props {
  id: string;
  label: string;
  options: readonly string[];
  class?: string;
}

const { id, label, options, class: extraClass } = Astro.props;
---

<p class:list={['flex flex-col', extraClass]}>
  <label for={id} class="mb-1 font-medium text-slate-800">
    {label} <span aria-hidden="true">*</span>
  </label>
  <select
    id={id}
    name={id}
    required
    aria-required="true"
    aria-describedby={`error-${id}`}
    class="rounded-md border border-slate-400 bg-white px-3 py-2 text-[#001D4A] focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600 focus:outline-hidden"
  >
    <option value="">Selecciona una opción</option>
    {options.map((option) => <option value={option}>{option}</option>)}
  </select>
  <FieldError forField={id} />
</p>
