---
interface Props {
  name: string;
  value: string;
  required?: boolean;
}

const { name, value, required = false } = Astro.props;
// "2-3 meses" → "disponibilidad-2-3-meses" (mismos ids que el Hito 1)
const id = `${name}-${value.toLowerCase().replace(/\s+/g, '-')}`;
---

<p class="flex items-center gap-2">
  <input
    type="radio"
    id={id}
    name={name}
    value={value}
    required={required}
    class="h-4 w-4 accent-[#006992] focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 focus:outline-hidden"
  />
  <label for={id} class="text-slate-800">{value}</label>
</p>
