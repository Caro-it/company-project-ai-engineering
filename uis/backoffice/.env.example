# Copia este archivo como .env.local (ignorado por git). Nunca subas URLs privadas ni tokens.

# URL de services/api para cuenta, proveedores e incidencias (por defecto http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL de la API de inventario (Hito 5). Si no se define, se usa NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Telemetría: URL del receptor de eventos. Hoy el stub POST /telemetry/events de services/api;
# en la fase de almacenamiento, la implementación real (el backoffice no cambia).
# Sin esta variable la telemetría está apagada.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events
